<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kemall.iam.platform.infrastructure.persistence.mapper.PlatformMemberMapper">

    <sql id="memberConditions">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (u.username LIKE CONCAT('%', #{keyword}, '%')
                     OR u.nickname LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">
                AND pm.status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectPageList"
            resultType="com.kemall.iam.platform.infrastructure.persistence.entity.PlatformMemberRow">
        SELECT
            pm.id,
            pm.user_id,
            pm.status,
            pm.created_at,
            u.username,
            u.nickname
        FROM platform_member pm
        LEFT JOIN sys_user u
            ON u.id = pm.user_id
        <include refid="memberConditions"/>
        ORDER BY pm.created_at DESC, pm.id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="selectPageCount" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM platform_member pm
        LEFT JOIN sys_user u
            ON u.id = pm.user_id
        <include refid="memberConditions"/>
    </select>

</mapper>
