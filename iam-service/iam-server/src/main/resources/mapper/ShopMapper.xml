<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kemall.iam.tenancy.infrastructure.persistence.mapper.ShopMapper">

    <sql id="shopConditions">
        <where>
            <if test="tenantId != null">
                AND s.tenant_id = #{tenantId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (s.shop_code LIKE CONCAT('%', #{keyword}, '%')
                     OR s.shop_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">
                AND s.status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectPageList" resultType="com.kemall.iam.tenancy.infrastructure.persistence.entity.ShopPO">
        SELECT
            s.id,
            s.tenant_id,
            s.shop_code,
            s.shop_name,
            s.logo_url,
            s.status,
            s.timezone,
            s.created_at,
            s.updated_at
        FROM shop s
        <include refid="shopConditions"/>
        ORDER BY s.created_at DESC, s.id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="selectPageCount" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM shop s
        <include refid="shopConditions"/>
    </select>

</mapper>
