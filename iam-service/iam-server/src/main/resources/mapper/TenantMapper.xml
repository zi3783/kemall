<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kemall.iam.tenancy.infrastructure.persistence.mapper.TenantMapper">

    <sql id="tenantConditions">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (t.tenant_code LIKE CONCAT('%', #{keyword}, '%')
                     OR t.tenant_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">
                AND t.status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectPageList" resultType="com.kemall.iam.tenancy.infrastructure.persistence.entity.TenantPO">
        SELECT
            t.id,
            t.tenant_code,
            t.tenant_name,
            t.plan_code,
            t.status,
            t.expires_at,
            t.created_at,
            t.updated_at
        FROM tenant t
        <include refid="tenantConditions"/>
        ORDER BY t.created_at DESC, t.id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="selectPageCount" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM tenant t
        <include refid="tenantConditions"/>
    </select>

</mapper>
